{
  "name": "mindrise-backend",
  "version": "1.0.0",
  "private": true,
  "description": "MindRise Node.js and Express backend",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:test": "NODE_ENV=test node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "test": "node --test tests/",
    "lint": "node --check src/server.js && node --check src/app.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.0",
    "pg": "^8.13.1",
    "pino": "^9.9.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
