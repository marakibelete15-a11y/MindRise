PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mindrise_dev
DB_USER=your_local_postgres_user
DB_PASSWORD=replace_with_local_database_password
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
UPLOAD_DIR=uploads/avatars
CORS_ORIGIN=http://localhost:5500
BCRYPT_ROUNDS=10
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_PEPPER=replace_with_a_long_random_otp_pepper
OTP_DRIVER=console
REPORT_THRESHOLD=3
REPORT_WINDOW_HOURS=24
MAX_AVATAR_BYTES=5242880
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=placeholder
SMTP_PASSWORD=replace_with_local_mail_password
SMS_PROVIDER=disabled
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=replace_with_32_byte_base64_encryption_key